{
  "buildCommand": "pnpm build",
  "outputDirectory": "web/dist",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "functions": {
    "api/**/*.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
